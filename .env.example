# 이 파일을 .env 로 복사한 뒤 값을 채우세요: cp .env.example .env

# Vite 클라이언트 (VITE_ 접두사만 브라우저 번들에 노출됨)
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Claude Code Supabase MCP (.mcp.json 에서 ${SUPABASE_PROJECT_REF} 로 참조)
SUPABASE_PROJECT_REF=<project-ref>
